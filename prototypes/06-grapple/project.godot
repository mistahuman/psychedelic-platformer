; Engine configuration file.
; Prototype 06 — grapple.
; Open THIS folder as the Godot project.

config_version=5

[application]

config/name="06 - Grapple"
config/description="Hook, swing, let go. One button, and the whole game is when you release it."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controls="*res://scripts/controls.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

2d/default_gravity=1250.0

[rendering]

environment/defaults/default_clear_color=Color(0.08, 0.06, 0.13, 1)
