[ext_resource type="Script" path="res://scripts/debug_overlay.gd" id="10"]

[sub_resource type="Environment" id="environment"]
background_mode = 1
background_color = Color(0.07, 0.05, 0.04, 1)
ambient_light_source = 2
ambient_light_color = Color(0.65, 0.55, 0.5, 1)
ambient_light_energy = 0.45

[sub_resource type="StandardMaterial3D" id="mouth_material"]
transparency = 1
shading_mode = 0
albedo_color = Color(1, 0.4, 0.6, 0.35)

[sub_resource type="SphereMesh" id="mouth_mesh"]
material = SubResource("mouth_material")
radius = 0.06
height = 0.08

[node name="Main" type="Node3D"]
script = ExtResource("1")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("environment")

; Straight down, so every shadow sits exactly under the thing casting it:
; the shadow is how you read a hand's height from a fixed camera.
[node name="Lamp" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0, 1, 0, -1, 0, 0, 2, 0)
light_color = Color(1, 0.84, 0.62, 1)
light_energy = 1.4
shadow_enabled = true
directional_shadow_mode = 0
directional_shadow_max_distance = 4.0

; Seated at the near edge. main.gd aims it at the table.
[node name="Camera" type="Camera3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.62, 0.78)
fov = 58.0

[node name="Table" parent="." instance=ExtResource("2")]

[node name="Papers" parent="." instance=ExtResource("5")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.3, 0.02, 0.12)

[node name="Lighter" parent="." instance=ExtResource("6")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.28, 0.02, 0.1)

[node name="Filter" parent="." instance=ExtResource("7")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.1, 0.03, 0.2)

[node name="Grinder" parent="." instance=ExtResource("8")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.1, 0.03, 0.05)

; Shown only while there is a rolled, unsealed one to bring here. main.gd places it.
[node name="Mouth" type="MeshInstance3D" parent="."]
visible = false
mesh = SubResource("mouth_mesh")

[node name="HandL" parent="." instance=ExtResource("4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.25, 0.2, 0.25)
side = "l"

[node name="HandR" parent="." instance=ExtResource("4")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.25, 0.2, 0.25)
side = "r"

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Hint" type="Label" parent="HUD"]
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -90.0
theme_override_colors/font_color = Color(1, 0.95, 0.85, 0.7)
theme_override_font_sizes/font_size = 18
text = "Left hand  WASD · Q E height · hold Space to grab what lights up
Right hand  arrows · PgDn PgUp height · hold Enter to grab what lights up
Shake = wiggle a hand left-right fast while holding        R reset · Tab debug"
