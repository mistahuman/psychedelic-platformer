[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/table.tscn" id="2"]
[ext_resource type="PackedScene" path="res://scenes/hand.tscn" id="4"]
[ext_resource type="PackedScene" path="res://scenes/items/papers.tscn" id="5"]
[ext_resource type="PackedScene" path="res://scenes/items/lighter.tscn" id="6"]
[ext_resource type="PackedScene" path="res://scenes/items/filter.tscn" id="7"]
